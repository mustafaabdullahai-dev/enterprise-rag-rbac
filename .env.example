# Enterprise RAG (RBAC + Guardrails) — configuration
#
# Copy to `.env` and adjust. Every value below is a default that works offline:
# with an empty .env the project runs with no API key and no model download.
#
#   cp .env.example .env

# ---- Application ---------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPOSE_DEMO_USERS=true              # show demo credentials in the console/login screen

# ---- Security ------------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# The application refuses to start with the development default when APP_ENV=production.
SECRET_KEY=dev-only-insecure-key-change-me
TOKEN_TTL_MINUTES=120
# Roles that may manage the index / read the compliance console.
ADMIN_ROLES=platform_admin
COMPLIANCE_ROLES=compliance_officer,platform_admin

# ---- Storage -------------------------------------------------------------
# Relative paths resolve against the project root.
DATA_DIR=data
# CHROMA_DIR=data/chroma
# WEB_DIR=frontend
CHROMA_COLLECTION=corporate_knowledge
AUTO_INGEST=true                    # build the index on first start if it is empty

# ---- Ingestion -----------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CANARY_PREFIX=CANARY-
EMBED_CANARY=true                   # embed canary tokens so leaks are *detected*, not just prevented

# ---- Embeddings ----------------------------------------------------------
# "hash" runs fully offline (feature hashing, no model download).
# "openai" uses any OpenAI-compatible /embeddings endpoint (production choice).
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=384
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_ENABLED=true

# ---- LLM -----------------------------------------------------------------
# "extractive" (default) answers offline from authorised excerpts only.
# "openai"  uses any OpenAI-compatible /chat/completions endpoint:
#            Groq, OpenAI, Together, vLLM, Ollama, ...
LLM_BACKEND=extractive
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SECONDS=45

# ---- Retrieval -----------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=24
MIN_RELEVANCE_SCORE=0.35
USE_BM25=true                       # hybrid lexical + vector retrieval
RRF_K=60
MAX_CONTEXT_CHARS=9000

# ---- Guardrails ----------------------------------------------------------
MAX_QUERY_CHARS=2000
HARD_QUERY_CHARS=6000
GUARDRAIL_BLOCK_THRESHOLD=60
GUARDRAIL_REFUSE_THRESHOLD=30
REDACT_PII_IN_OUTPUT=true
EXPOSE_GUARDRAIL_TRACE=true         # return the per-node trace to the requester
EXPOSE_WITHHELD_COUNT=true          # tell the requester what the ACL withheld
MAX_GRAPH_RETRIES=1

# ---- API safety limits ---------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=20
RATE_LIMIT_QUERIES_PER_DAY=300

# ---- Ragas (optional evaluation extra: pip install -r requirements-eval.txt)
# Ragas needs an LLM judge; point these at the same endpoint as the LLM above.
RAGAS_LLM_MODEL=
RAGAS_EMBEDDING_MODEL=